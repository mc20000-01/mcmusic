#!/usr/bin/env python3
"""Launch the mcmusic desktop client from a checkout.

No flag opens the Qt window; ``--tui`` starts the terminal client. The
dispatcher is imported instead of the Qt module so the terminal mode works on
machines without PySide6.
"""
import os
import sys

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))

from mcmusic_linux.cli import main  # noqa: E402

raise SystemExit(main())
