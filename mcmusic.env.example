# Copy to mcmusic.env and fill in. Never commit the filled copy.

# --- where things live ------------------------------------------------------
PUBLIC_URL=https://music.example.com
MUSIC_DIR=/srv/mcmusic/music
DATA_DIR=/srv/mcmusic/data

# --- first-run bootstrap ----------------------------------------------------
# Single-use code for creating the first account.
INVITE_CODE=change-me

# --- outgoing mail (password resets, build emails) --------------------------
SMTP_HOST=mail.example.com
SMTP_PORT=587
SMTP_USER=mcmusic
SMTP_PASSWORD=
SMTP_FROM=mcmusic@example.com
SMTP_STARTTLS=1

# --- RoturLink (optional; leave blank to disable) ---------------------------
ROTUR_APP=
ROTUR_SECRET=
ROTUR_REDIRECT_URI=https://music.example.com/api/auth/rotur/callback
# Token Manager sub-token with account:profile; required for live activity.
ROTUR_TOKEN=

# --- Discord bridge (optional) ---------------------------------------------
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
DISCORD_ADMIN_TOKEN=
# Shared server-to-bot credential; generate a long random value.
MCMUSIC_BOT_TOKEN=
# Discord account linking (OAuth2) — redirect URI is
# <public-url>/api/auth/discord/callback. The client ID may also be supplied
# as DISCORD_APPLICATION_ID; leave Public Client off and keep the secret here.
# The bot also needs Message Content Intent enabled in the portal.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=
# Optional: override the id used for Rich Presence. Defaults to DISCORD_CLIENT_ID
# (same application). Needs the Discord desktop client on this host.
DISCORD_APP_ID=

# --- activity bridge (optional) --------------------------------------------
MCMUSIC_BASE=https://music.example.com
ROTUR_NAME=
